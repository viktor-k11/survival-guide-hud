#!/bin/sh
#
# Scene hygiene pre-commit hook.
#
# Install (from the repo root):
#     ln -sf "../../Specs Base Template/Tools/pre-commit" .git/hooks/pre-commit
#
# Blocks a commit when Assets/Scene.scene has a root-level SceneObject that is
# not in Tools/scene-roots-allowlist.json. Bypass with `git commit --no-verify`
# if you genuinely need to.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
TOOLS="$REPO_ROOT/Specs Base Template/Tools"
CHECKER="$TOOLS/check-scene-roots.py"
PROMPTS="$TOOLS/build-prompts.py"

STAGED=$(git diff --cached --name-only)

blocked() {
    echo ""
    echo "[pre-commit] BLOCKED. $1"
    echo "[pre-commit] Override with: git commit --no-verify"
    exit 1
}

# Only bother when the scene is actually part of this commit.
if [ -f "$CHECKER" ] && echo "$STAGED" | grep -q "Assets/Scene.scene"; then
    echo "[pre-commit] checking scene roots..."
    python3 "$CHECKER" || blocked "Fix the scene or update the allowlist."
fi

# The Lens loads prompts.generated.json, not the .txt sources — a stale mirror
# means shipping the OLD prompt with no error anywhere.
if [ -f "$PROMPTS" ] && echo "$STAGED" | grep -q "Assets/AI/.*prompt"; then
    echo "[pre-commit] checking generated prompts are current..."
    python3 "$PROMPTS" --check || blocked "Run: python3 'Specs Base Template/Tools/build-prompts.py'"
fi

exit 0
