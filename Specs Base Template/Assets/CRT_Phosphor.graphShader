    Node10:
      DependencyIndex: 10
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_color4 colorIn;
            input_float glowIntensity;
            input_float scanlineCount;
            input_float scanlineStrength;
            input_float scanlineScroll;
            input_float flickerAmount;
            input_float flickerRate;
            input_float wipeProgress;
            input_float wipeSoftness;
            input_float wipeAxis;
            output_vec4 result;

            void main()
            {
            	float t = system.getTimeElapsed();

            	// CRT scanlines belong to the DISPLAY, not the object: screen space, so the
            	// hologram and the panel share one density and read as one device.
            	float sy = system.getScreenUVCoord().y;
            	float scan = 1.0 - scanlineStrength * (0.5 + 0.5 * sin((sy * scanlineCount - t * scanlineScroll) * 6.2831853));

            	// Phosphor flicker: two incommensurate sines so it never loops audibly.
            	// Floored: on an additive display a black frame reads as a crash.
            	float flick = 1.0 - flickerAmount * (0.55 + 0.35 * sin(t * flickerRate * 6.2831853) + 0.10 * sin(t * flickerRate * 17.077));
            	flick = max(flick, 0.25);

            	// Boot scanline wipe: reveal bottom-to-top across the mesh's own local
            	// bounds. wipeAxis 0 = local Y (holograms); 1 = local Z (the panel plate,
            	// whose plane preset is XZ-native so its height axis is Z).
            	vec3 lo = system.getAABBMinLocal();
            	vec3 hi = system.getAABBMaxLocal();
            	vec3 pos = system.getSurfacePositionObjectSpace();
            	float span; float coord;
            	if (wipeAxis > 0.5) { span = hi.z - lo.z; coord = pos.z - lo.z; }
            	else { span = hi.y - lo.y; coord = pos.y - lo.y; }
            	float yNorm = clamp(coord / max(span, 0.0001), 0.0, 1.0);
            	float soft = max(wipeSoftness, 0.001);
            	float reveal = 1.0 - smoothstep(wipeProgress, wipeProgress + soft, yNorm);
            	float edgeGlow = (wipeProgress < 1.0) ? exp(-abs(yNorm - wipeProgress) / soft) * 1.5 : 0.0;

            	vec3 rgb = colorIn.rgb * glowIntensity * scan * flick * reveal + colorIn.rgb * edgeGlow;
            	result = vec4(rgb, colorIn.a * reveal);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: CRT Phosphor
        UseExternalFile:
          Variable: false
        colorIn:
          ClassType1: COLOR
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [1.0, 1.0, 1.0, 1.0]
        glowIntensity:
          Connection0:
            NodeLevelID: 10
            PortID: Output
          Variable: 1.8
        scanlineCount:
          Connection0:
            NodeLevelID: 11
            PortID: Output
          Variable: 220.0
        scanlineStrength:
          Connection0:
            NodeLevelID: 12
            PortID: Output
          Variable: 0.3
        scanlineScroll:
          Connection0:
            NodeLevelID: 13
            PortID: Output
          Variable: 0.06
        flickerAmount:
          Connection0:
            NodeLevelID: 14
            PortID: Output
          Variable: 0.1
        flickerRate:
          Connection0:
            NodeLevelID: 15
            PortID: Output
          Variable: 11.0
        wipeProgress:
          Connection0:
            NodeLevelID: 16
            PortID: Output
          Variable: 1.0
        wipeSoftness:
          Connection0:
            NodeLevelID: 17
            PortID: Output
          Variable: 0.08
        wipeAxis:
          Connection0:
            NodeLevelID: 18
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 400
        ngs_Version:
