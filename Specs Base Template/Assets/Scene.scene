  ScriptInputs:
    "":
      theme: !<MappingBased.AssignableType_1> c1692b36-dfd7-4eaf-b562-194fa4988a33
      mainMenu: !<reference.SceneObject> 047a8a25-058a-4721-854a-8db70ecc4928
      cameraObject: !<reference.SceneObject> 00000000-0000-0065-0000-000000000064
      quadMesh: !<reference.RenderMesh> 9c7cf554-730c-4975-a208-a19a01740f30
      iconMaterial: !<reference.Material> b70f04ba-96e8-415c-abfc-2f02f8869b09
      rowLabels: !<string[]>
        - SCAN THIS AREA
        - I NEED SHELTER
        - I NEED FIRE
        - I NEED WATER
        - "I'M HURT"
        - BACK TO CAMP
      rowDescriptions: !<string[]>
        - "Sweeps the ground ahead and rates flat, safe spots for a tent and a fire."
        - A step-by-step tent pitch with staged blueprint holograms on your chosen site.
        - "Build a campfire: cleared ground, tinder, log-cabin stack, then a safe light."
        - "Purify found water, with boil timers and a gear checklist along the way."
        - "First aid for a burn, step by step. In a real emergency, say SOS."
        - "Points you home: the row reads the live distance back to your marked camp."
      scanReadyValue: READY
      scanDoneValue: DONE
      descriptionWrapChars: !<float> 26.000000
      trailLine: TRAIL OFF
      chipSetCampLabel: "[ SET CAMP ]"
      chipTrailLabel: "[ LEAVING CAMP ]"
      chipTrailRecLabel: "[ ● REC ]"
      chipFollowLabel: "[ FOLLOW TRAIL ]"
      chipLogLabel: "[ LOG ]"
      askTitle: ASK ME ANYTHING
      askExamples: !<string[]>
        - 'try: "how do I splint a broken wrist"'
        - 'try: "which way is north, no compass"'
        - 'try: "how do I dry wet boots overnight"'
        - 'try: "help me build a snare"'
        - 'try: "what firewood burns longest"'
      askExampleIntervalSec: !<float> 3.000000
      caretHz: 2.500000
      promptMaxChars: !<float> 30.000000
      enableDebugKeys: true
      keyCycleHighlight: J
      keyActivate: L
      enableLogging: true
  ScriptTypes:
