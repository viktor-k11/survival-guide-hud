    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Main-menu rows 2-5 are the same trick as a marker tap: a fixed phrase through the SAME generative lesson path. No fixtures, no special-casing.</span>"}'
    - '// @input string waterPhrase = "help me purify water"'
    - '// @input string burnPhrase = "how do I treat a burn"'
