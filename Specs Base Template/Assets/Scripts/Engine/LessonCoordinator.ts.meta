    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Tapping a site marker SPEAKS one of these. It is a shortcut for talking, not a fixture: the plan is generated by Gemini exactly as if the words had been said out loud.</span>"}'
