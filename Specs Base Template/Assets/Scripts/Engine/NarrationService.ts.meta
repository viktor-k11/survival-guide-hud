    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Boot pre-warm — the works-today path</span>"}'
    - '// @input bool enablePrewarm = true {"hint":"Synthesize the fixed phrases once at boot so they are instant when first used."}'
