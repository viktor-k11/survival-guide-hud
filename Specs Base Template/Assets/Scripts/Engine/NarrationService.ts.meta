    - '// @input string[] prewarmPhrases = {"Next step.","Going back.","Got it.","Careful.","Surveying knowledge.","Lesson complete. Well done."} {"hint":"The fixed phrases. Keep these in step with the copy the rest of the HUD uses.", "widget":"text_area"}'
    - // @input bool enableLogging = true
