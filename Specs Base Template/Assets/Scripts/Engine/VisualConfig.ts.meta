    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Typography</span>"}'
    - '// @input Asset.Font font {"hint":"HUD typeface. JetBrains Mono by default: monospace keeps NN/NN and MM:SS from jittering, and it has a weight axis so strokes can be thickened for an additive display. VT323 is still in the project if you want the CRT look back."}'
    - '// @ui {"widget":"separator"}'
