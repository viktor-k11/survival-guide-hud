    - '// @input vec4 warningColor = {1,0.3,0.22,1} {"hint":"Warning: safety-gated steps, distance warnings, the status-bar warning strip.", "widget":"color"}'
    - '// @input vec4 dimColor = {0.12,0.38,0.22,1} {"hint":"Dimmed state: unchecked checklist rows, inactive chrome. Still emissive, just quieter.", "widget":"color"}'
