    - '// @input float glowIntensity = 1 {"hint":"Multiplier applied to emissive strength. 1.0 = as authored.", "widget":"slider", "min":0, "max":3, "step":0.05}'
    - '// @input float panelOpacity = 0.3 {"hint":"Backing-plate strength. On an additive display this brightens the glow; it never darkens what is behind it.", "widget":"slider", "min":0, "max":1, "step":0.01}'
