    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Palette</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Bright saturated only. Dark values disappear on an additive display.</span>"}'
