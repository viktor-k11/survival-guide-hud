  InputLines:
    - '// @input SceneObject hudRoot {"hint":"HUDRoot."}'
    - '// @input SceneObject cameraObject {"hint":"Camera Object."}'
    - '// @input float distanceCm = 120 {"hint":"How far in front of the user the HUD sits, centimetres. Matches the authored z = -120."}'
    - '// @input float tauXZ = 0.13 {"hint":"Seconds to close ~63% of the horizontal (XZ) position gap. 0.13 reproduces the tuned Headlock feel (easing 0.25 at 60 fps).", "widget":"slider", "min":0.05, "max":1, "step":0.01}'
    - '// @input float tauY = 0.13 {"hint":"Seconds to close ~63% of the vertical (Y) position gap.", "widget":"slider", "min":0.05, "max":1, "step":0.01}'
    - '// @input float tauPitch = 0.13 {"hint":"Seconds to close ~63% of the pitch gap.", "widget":"slider", "min":0.05, "max":1, "step":0.01}'
    - '// @input float tauYaw = 0.13 {"hint":"Seconds to close ~63% of the yaw gap.", "widget":"slider", "min":0.05, "max":1, "step":0.01}'
    - '// @input float bufferTranslationCm = 6 {"hint":"Head translation, centimetres, before the HUD starts to follow. Tuned value 6."}'
    - '// @input float bufferPitchDeg = 3 {"hint":"Degrees of pitch dead-zone in each direction. Tuned value 3."}'
    - '// @input float bufferYawDeg = 3 {"hint":"Degrees of yaw dead-zone in each direction. Tuned value 3."}'
    - '// @input float dtClampSec = 0.1 {"hint":"Ceiling on the dt fed to the smoothing, seconds. A hitch longer than this advances the ease by exactly this much — the HUD can never jump further than one clamped step.", "widget":"slider", "min":0.02, "max":0.5, "step":0.01}'
    - '// @input float driftSnapCm = 400 {"hint":"Belt-and-braces: if the HUD is ever further than this from its own computed target, snap the follow state to the camera and log. With stable maths this should NEVER fire; if it does, the maths is wrong — report it, do not raise the threshold.", "widget":"slider", "min":150, "max":2000, "step":50}'
    - '// @input float logIntervalSec {"hint":"Log distance-from-target every N seconds (0 = off). Diagnostics for soak tests.", "widget":"slider", "min":0, "max":10, "step":1}'
    - // @input bool enableLogging = true
