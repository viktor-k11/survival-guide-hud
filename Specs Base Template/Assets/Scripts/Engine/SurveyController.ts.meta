  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Survey timing</span>"}'
    - '// @input SceneObject cameraObject {"hint":"Camera Object. The survey rays are cast from here, through its view."}'
    - '// @input float durationSec = 12 {"hint":"Full survey length in seconds. The survey ALWAYS ends by this point.", "widget":"slider", "min":2, "max":30, "step":0.5}'
    - '// @input float minDurationSec = 3 {"hint":"Never finish before this, however fast the ground fills in. Stops a lucky first frame from ending the survey instantly.", "widget":"slider", "min":0, "max":15, "step":0.5}'
    - '// @input float earlyExitGroundCells = 260 {"hint":"Cheap precondition for the early exit, and the denominator of the coverage half of surveyProgress. Distinct ground cells. Set it very high to force the full duration."}'
    - '// @input float earlyExitRequiresTents = 2 {"hint":"Early exit needs this many tent sites plus a fire. 2 = the user gets a real choice. If the terrain cannot offer that many, the survey simply runs its full duration and reports what it found."}'
    - '// @input float earlyExitCheckSec = 1 {"hint":"How often the early-exit check runs the selector, in seconds. It is the only expensive thing in the loop, so it is not run every frame.", "widget":"slider", "min":0.25, "max":5, "step":0.25}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Terrain source</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Hard rule 5. A stored cloud makes the survey deterministic, and it is the ONLY way to exercise this on a desk: the Preview panel cannot feed a real one (see the note on cloudFixture).</span>"}'
    - '// @input bool useFixtureCloud {"hint":"Read the point cloud from cloudFixture instead of casting World Query rays. The rest of the survey — timeline, progress, early exit, scoring, markers — is unchanged."}'
    - "// @input Asset.JsonAsset cloudFixture {\"hint\":\"Assets/Survey/fixtures/*.json — a stored cloud in CENTIMETRES. The Preview panel's simulated depth resolves only about five taps per pose and its device camera never moves, so a live survey there tops out at a handful of points; a stored cloud is how the markers and the distance guard get verified off-device.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Ray grid</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">World Query resolves at roughly 5 Hz, so more rays per frame does not mean more detail — it means wider coverage of whatever the user is looking at right now.</span>"}'
    - '// @input float raysPerFrame = 8 {"hint":"Rays fired per frame. They walk through the lattice below, so the whole pattern is covered every few frames.", "widget":"slider", "min":1, "max":24, "step":1}'
    - '// @input float gridColumns = 7 {"hint":"Lattice columns across the view."}'
    - '// @input float gridRows = 5 {"hint":"Lattice rows down the view."}'
    - '// @input float yawHalfAngleDeg = 28 {"hint":"Half-width of the ray fan in degrees, left and right of centre.", "widget":"slider", "min":5, "max":60, "step":1}'
    - '// @input float pitchMaxDeg = 6 {"hint":"Top of the fan, degrees relative to the view centre. Slightly positive so a user looking level still samples ground ahead."}'
    - '// @input float pitchMinDeg = -42 {"hint":"Bottom of the fan, degrees. Negative = downward. The ground is below eye level, so the fan is biased down."}'
    - '// @input float rayRangeCm = 900 {"hint":"How far each ray reaches, centimetres."}'
    - '// @input bool filterHits {"hint":"Smooth hit results over time. OFF for a survey: filtering trades positional truth for stability, and this is a measurement, not a placement."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Point cloud</span>"}'
    - '// @input float dedupeCellCm = 8 {"hint":"Hits closer together than this collapse into one point, centimetres. Keeps a stare at one spot from swamping the cloud."}'
    - '// @input float maxPoints = 6000 {"hint":"Hard cap on stored points. Reached, the survey keeps running but stops growing."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Site scoring — all pure inputs to SiteSelection.ts</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">METRES. These are passed straight into the pure selector; nothing here reads the scene.</span>"}'
    - '// @input float tentFootprintM = 2.5 {"hint":"Tent footprint, metres square."}'
    - '// @input float fireFootprintM = 1.2 {"hint":"Fire footprint, metres across."}'
    - '// @input float minFireToTentM = 3 {"hint":"HARD CONSTRAINT: minimum fire-to-tent distance, metres. Cannot be met -> the fire is still placed and distanceWarning fires."}'
    - '// @input float minTentSeparationM = 3 {"hint":"Two tent suggestions closer than this are the same site twice."}'
    - '// @input float cellSizeM = 0.25 {"hint":"Binning resolution, metres."}'
    - '// @input float minUpDot = 0.85 {"hint":"Surface counts as ground above this normal.y. 1 = perfectly level."}'
    - '// @input float flatnessToleranceM = 0.12 {"hint":"Height spread across a footprint that scores flatness 0, metres."}'
    - '// @input float preferredMinDistanceM = 1.5 {"hint":"Nearest comfortable site distance, metres."}'
    - '// @input float preferredMaxDistanceM = 6 {"hint":"Furthest comfortable site distance, metres."}'
    - '// @input float maxDistanceM = 12 {"hint":"Beyond this it is a hike, not a suggestion."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Debug</span>"}'
    - "// @input float logFirstNHits {\"hint\":\"Log this many individual hits per survey, with position and normal. 0 = off. The way to tell 'the rays are missing' from 'the rays all land in the same place'.\"}"
    - '// @input bool enableDebugKeys = true {"hint":"Turn off before shipping."}'
    - "// @input string keyRestartSurvey = \"P\" {\"hint\":\"Restart the survey from scratch. P as in re-Ping — 'S' is walk-back and injected keys reach the Lens.\"}"
    - '// @input string keyFinishSurvey = "G" {"hint":"End the survey immediately with whatever has been collected."}'
    - // @input bool enableLogging = true
