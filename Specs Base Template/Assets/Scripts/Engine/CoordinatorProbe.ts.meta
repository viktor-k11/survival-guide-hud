    - "// @input float scenario {\"hint\":\"Which scripted run to perform. 'failures' costs two Gemini calls; 'happy' and 'marker' cost one each.\", \"widget\":\"combobox\", \"values\":[{\"label\":\"failures — the four failure paths\", \"value\":0}, {\"label\":\"happy — one real request, end to end\", \"value\":1}, {\"label\":\"marker — a site tap drives a real request\", \"value\":2}, {\"label\":\"qa — load a lesson, then ask a question mid-lesson\", \"value\":3}, {\"label\":\"keyboard — open the AR keyboard, then submit through the seam\", \"value\":4}]}"
