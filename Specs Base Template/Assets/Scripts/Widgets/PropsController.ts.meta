  InputLines:
    - // @input AssignableType_1 theme
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Objects this controller drives</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Props (Prop_Log_*) and slots (SnapSlot_*) are found by name prefix under the container, so the contract is Docs/SCENE-MAP.md. Slot transforms ARE the pattern — edit them in the Inspector.</span>"}'
    - '// @input SceneObject propsContainer {"hint":"WorldRoot/PropsContainer"}'
    - '// @input SceneObject cameraObject {"hint":"Camera Object — the pattern anchors ahead of the user, within reach."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Placement — within reach, by rule</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">A pinch reaches ~0.6 m. Ground content this close is outside a level gaze (~13° down before the floor enters the window), which is exactly why the cue line below exists.</span>"}'
    - '// @input float reachCm = 55 {"hint":"How far ahead of the user the pattern stands, centimetres. Keep it a reach, not a walk.", "widget":"slider", "min":30, "max":150, "step":5}'
    - '// @input float snapRadiusCm = 50 {"hint":"Release closer than this to an EMPTY slot (of the matching kind) snaps the prop in; anything further returns it to rest. Centimetres, world. Generous on purpose: pinch precision is coarse on device, and typed slots + nearest-empty keep a sloppy drop honest — a log dropped onto the stack simply seats in the next open layer.", "widget":"slider", "min":10, "max":80, "step":1}'
    - '// @input float returnSec = 0.25 {"hint":"Seconds for the missed-release glide back to the rest pose. 0 = instant return — the pre-agreed fallback, and nobody watching can tell.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Look</span>"}'
    - '// @input float ghostLevel = 0.35 {"hint":"Resting brightness of the empty-slot ghosts.", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - '// @input float hoverTint = 0.65 {"hint":"How far a hovered log tints toward the accent colour.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float flashSec = 0.45 {"hint":"Seconds the snap confirmation flash takes to decay.", "widget":"slider", "min":0.1, "max":1.5, "step":0.05}'
    - '// @input string cueText = "LOOK DOWN · STACK THE LOGS" {"hint":"StatusBar cue when the props appear. The frustum rule: near ground content is allowed ONLY when the HUD says to look down. Keep it under ~34 characters."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Debug</span>"}'
    - '// @input string keyForceProps = "X" {"hint":"Force the prop step open/closed without a lesson — the interaction is testable on a desk. Same right-hand-cluster rule as every debug key: never W/A/S/D, Q/E or the arrows."}'
    - '// @input string keyAutoPlace = "Z" {"hint":"Auto-place the next free prop into its nearest empty matching slot, through the SAME release path a real drop takes (kind gating, snap, flash, propSnapped). Exists because the synthetic hand cannot pinch every prop reliably; a real hand can. Never ships doing anything — it is a no-op unless the window is open."}'
    - // @input bool enableDebugKeys = true
    - // @input bool enableLogging = true
