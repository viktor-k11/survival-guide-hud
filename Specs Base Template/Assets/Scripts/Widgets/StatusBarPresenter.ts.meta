  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Objects this presenter drives</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">All exist at design time. This script never creates any of them, and it no longer touches HUDRoot — ModeRouter owns that.</span>"}'
    - // @input AssignableType_1 theme
    - '// @input SceneObject statusBar {"hint":"HUDRoot/StatusBar"}'
    - '// @input SceneObject micIcon {"hint":"HUDRoot/StatusBar/MicIcon"}'
    - '// @input Component.Text hintText {"hint":"HUDRoot/StatusBar/HintText"}'
    - '// @input Component.Text tickerText {"hint":"HUDRoot/StatusBar/ExampleTicker"}'
    - '// @input Component.Text lessonTitle {"hint":"HUDRoot/StatusBar/LessonTitle"}'
    - '// @input SceneObject warningStrip {"hint":"HUDRoot/StatusBar/WarningStrip"}'
    - "// @input SceneObject keyboardToggle {\"hint\":\"HUDRoot/StatusBar/KeyboardToggle — tap to open the AR keyboard. The demo's safety net when voice misbehaves.\"}"
    - "// @input Asset.RenderMesh quadMesh {\"hint\":\"PH_Plane.mesh — MicIcon's placeholder is a disc, which maps an icon texture unreadably. A quad makes the glyph legible.\"}"
    - '// @input Asset.Material iconMaterial {"hint":"PH_Icon.mat — an unlit additive material with ENABLE_BASE_TEX baked on. The other PH_ materials gate baseTex behind that define, so assigning a texture to them silently does nothing."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Idle copy</span>"}'
    - '// @input string idleHint = "PINCH & HOLD — ASK FOR HELP"'
    - '// @input string listeningHint = "LISTENING… RELEASE WHEN DONE"'
    - '// @input string finalizingHint = "THINKING…"'
    - '// @input string[] tickerPrompts = {"\"how do I signal for rescue\"","\"which way is north, no compass\"","\"how do I keep food from bears\"","\"how do I read incoming weather\""} {"hint":"Rotating idle examples. These teach the user the system takes any request — so they must stay OUTSIDE the six main-menu rows, or they prove the opposite.", "widget":"text_area"}'
    - '// @input float tickerIntervalSec = 2.5 {"hint":"Seconds each example stays up.", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Compiling — the 12-second wait</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Gemini takes 10.9-15 s and that will not change. These settings are what stops the wait reading as a crash.</span>"}'
    - '// @input float typewriterCharsPerSec = 26 {"hint":"Typewriter speed for echoing the request back, characters per second.", "widget":"slider", "min":6, "max":80, "step":1}'
    - '// @input string[] compilingLines = {"SURVEYING KNOWLEDGE","DRAFTING STEPS","CHECKING SAFETY","PLACING WIDGETS"} {"hint":"Status lines cycled while the guide is thinking. Short, active, and honest about what is happening.", "widget":"text_area"}'
    - '// @input float compilingLineSec = 2.2 {"hint":"Seconds each status line holds.", "widget":"slider", "min":0.8, "max":6, "step":0.1}'
    - '// @input float workingTickHz = 3 {"hint":"How often the working ticker advances, Hz. This is the guarantee that SOMETHING moves every second.", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input string[] workingFrames = {"·","··","···"} {"hint":"Frames of the working ticker, cycled at workingTickHz."}'
    - "// @input float busyHoldSec = 2.5 {\"hint\":\"How long the 'still working' notice stays up when a second request is ignored.\", \"widget\":\"slider\", \"min\":0.5, \"max\":6, \"step\":0.5}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">In-lesson Q&amp;A</span>"}'
    - '// @input float qaHoldSec = 9 {"hint":"How long a spoken answer stays up AFTER its voice has finished. The clock does not start while the answer is still being synthesized or spoken — otherwise the text expires before the sentence is said.", "widget":"slider", "min":2, "max":20, "step":1}'
    - '// @input float qaWrapChars = 46 {"hint":"Characters per line for the answer. World-space Text has no width to wrap against."}'
    - '// @input string keyboardToggleLabel = "TYPE" {"hint":"Copy shown on the keyboard affordance."}'
    - "// @input float holoCueHoldSec = 7 {\"hint\":\"How long the hologram's 'look down' cue holds. World content outside a level gaze is only allowed if this line appears — see Docs/SCENE-MAP.md.\", \"widget\":\"slider\", \"min\":2, \"max\":20, \"step\":1}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Waiting for the voice</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Synthesis measures 6.5-18.6 s. The step is readable the instant it arrives — text has never waited on audio — but the line under it used to sit blank for that whole window, which reads as \"it did not hear me\". This is what fills it.</span>"}'
    - "// @input string voicePendingHint = \"VOICE INCOMING\" {\"hint\":\"Shown in a lesson while the current step's audio is still being synthesized. Cleared the moment it speaks.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #7CFFB2;\">Navigate</span>"}'
    - '// @input string navBearingHint = "FOLLOW THE ARROW — SAY STOP TO EXIT" {"hint":"Hint line in NAVIGATE, bearing mode."}'
    - '// @input string navTrailHint = "FOLLOW THE STAKES — SAY STOP TO EXIT" {"hint":"Hint line in NAVIGATE, trail mode."}'
    - '// @input string navLineFormat = "CAMP {D} M" {"hint":"Distance readout. {D} = metres."}'
    - '// @input string navLastKnownSuffix = " · LAST KNOWN BEARING" {"hint":"Appended while tracking is lost — the readout must SAY it is last known."}'
